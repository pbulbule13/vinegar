# Vinegar Home Assistant - Environment Variables
# Copy this to .env.local and fill in your values
# NONE of these are required for basic operation (LAN dev mode)

# Euri API key for LLM (text chat) - get from https://euron.one
EURI_API_KEY=

# OpenAI API key for premium voice (Realtime API) - optional
OPENAI_API_KEY=

# Auth token for API routes (leave empty to disable auth in dev/LAN mode)
VINEGAR_AUTH_TOKEN=

# Database path (defaults to ./vinegar.db)
DATABASE_PATH=

# CORS allowed origin (defaults to http://192.168.1.15:8080)
ALLOWED_ORIGIN=

# OpenWeatherMap API key (free tier: 1000 calls/day) - get from https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# Default city for weather (used when no location specified)
WEATHER_CITY=

# Google Maps API key (free $200/month credit) - get from https://console.cloud.google.com
# Enable: Directions API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=

# Euri API base URL (defaults to https://api.euron.one/api/v1/euri)
EURI_BASE_URL=

# Server URL for Capacitor Android app (defaults to http://192.168.1.15:3000)
VINEGAR_SERVER_URL=

# Image search APIs (for Visual Context Panel)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
